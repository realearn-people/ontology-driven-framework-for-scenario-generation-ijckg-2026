{
  "dataset_section_purpose": "Documents the retrieval corpus so Conditions 2-4 are reproducible and comparable with Condition 1.",
  "condition_definitions": [
    {
      "condition_number": 1,
      "method": "prompt_only",
      "condition_name": "Prompt-Only Generation",
      "implementation": "No external retrieval and no ontology-derived context."
    },
    {
      "condition_number": 2,
      "method": "prompt_rag",
      "condition_name": "Text-RAG Generation",
      "implementation": "Attempts external Chroma vector retrieval; actual context exposure is audited per row."
    },
    {
      "condition_number": 3,
      "method": "ontology_prompt_rag",
      "condition_name": "Ontology-Derived Structured Prompting RAG",
      "implementation": "Attempts external RAG and adds a directly serialized PSQ-SCO semantic packet."
    },
    {
      "condition_number": 4,
      "method": "ontology_text_rag",
      "condition_name": "Ontology-to-Text Vector RAG",
      "implementation": "Attempts external Chroma vector retrieval and adds ontology-derived text selected by a deterministic lexical ranker; actual external-context exposure is audited per row, and the ontology-derived records are not embedded by the current implementation."
    }
  ],
  "same_sources_across_conditions": "Text-RAG Generation, Ontology-Derived Structured Prompting RAG, and Ontology-to-Text Vector RAG attempt retrieval from the same PSQ_RAG_PROFILE=quality external corpus selection unless explicitly overridden; the evaluator separately reports rows where retrieval returned no external context. Prompt-Only Generation is the no-retrieval baseline.",
  "kb_dir": "genai_engine/output",
  "rag_profile": "quality",
  "vector_database": "ChromaDB PersistentClient",
  "vector_index_path": "genai_engine/chroma_db_quality",
  "vector_space": "cosine HNSW",
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2 (expected Chroma default because rag_engine.py does not pass a custom embedding_function)",
  "embedding_model_status": "Expected from the official Chroma default-embedding documentation, not fully provenance-frozen for the historical generation run. The exact Chroma package version, model artifact hash, and embedding-function configuration were not stored in the generation records.",
  "embedding_model_training_domain": "General-purpose sentence-pair representation learning, not a cybersecurity-ontology-specific model. The all-MiniLM-L6-v2 model card reports 384-dimensional embeddings, fine-tuning on more than one billion sentence pairs, and truncation beyond 256 word pieces.",
  "embedding_model_domain_mismatch": "Because the model is general-purpose, source relevance for phishing/smishing/vishing and verbalized OWL records must be treated as an empirical retrieval question rather than assumed from the model name.",
  "ontology_text_selection": "The ontology-derived records are selected by a deterministic lexical relevance score, mandatory document-type coverage, and optional deterministic greedy relation walk. They are not stored in or retrieved from Chroma by the current implementation.",
  "ontology_walk_algorithm": {
    "scientific_name": "deterministic greedy relevance walk",
    "legacy_metadata_alias": "deterministic_random_walk_graph_to_text",
    "start_nodes": "up to five IDs ordered as selected templates, fixed-order validation rules, then evidence sources",
    "depth": "walk_depth=2 by default, producing depth 0, 1, and 2 nodes per start when edges exist",
    "edge_score": "count of case query terms occurring in property, target ID, target label, target definition, or target types; +1 when target is a known ontology record",
    "tie_break": "descending score, then property name ascending, then target ID ascending",
    "transition": "choose exactly one highest-ranked outgoing property-target pair at each step",
    "stopping": "stop at maximum depth, missing current record, or no outgoing candidate",
    "randomness": "none",
    "cycle_policy": "no visited-node exclusion in the historical implementation; depth bound guarantees termination",
    "frozen_run_exposure": "The paper run used ontology_text_doc_limit=4. Mandatory template/rule/source records plus the static Graph-CoT-inspired trace filled the four slots, so selected_subgraph_walk was exported in 0/360 Condition-4 rows. The algorithm exists in code but was not an active treatment component in this run."
  },
  "chunking": "One JSONL record is converted into one retrieval document by concatenating available text/subject/body/messages/dialogue/cue fields.",
  "preprocessing": "JSONL rows with short text are skipped; exact lowercased text hashes are deduplicated; profile caps limit very large corpora.",
  "retrieval_settings": {
    "query": "role, job title hint, channel, variant, knowledge type, interaction pattern, development focus, age group",
