    <dcterms:source rdf:resource="https://doi.org/10.1037/a0031311"/>
    <dcterms:source rdf:resource="https://doi.org/10.1080/07421222.2017.1334499"/>
    <dcterms:title xml:lang="en">PersonaShield Quest Scenario Control Ontology (PSQ-SCO) v9.1.0</dcterms:title>
    <rdfs:label xml:lang="en">PersonaShield Quest Scenario Control Ontology (PSQ-SCO) v9.1.0</rdfs:label>
    <psq:competencyQuestion xml:lang="en">CQ1 - Scenario Selection: Which ScenarioTemplate individuals satisfy learner profile, performance state, mood-context placeholder, target transition, channel, difficulty, attack type, and retrieval-mode constraints?</psq:competencyQuestion>
    <psq:competencyQuestion xml:lang="en">CQ2 - Cybersecurity Structure: Which attack or legitimate-communication concepts are explicitly linked to a selected ScenarioTemplate?</psq:competencyQuestion>
    <psq:competencyQuestion xml:lang="en">CQ3 - Content Quality Control: Which ontology constraints and quality rules must a generated candidate scenario satisfy before acceptance into the scenario pool?</psq:competencyQuestion>
    <psq:competencyQuestion xml:lang="en">CQ4 - Evidence and Provenance Grounding: Which trusted sources and provenance records justify scenario structure, red flags, safe indicators, recommended response, and validation decision?</psq:competencyQuestion>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">PSQ-SCO v9.1.0 is a corrected scenario-control ontology for PersonaShield Quest. It keeps the ontology limited to scenario-control resources and treats learning-design theory modules as outside the PSQ-SCO scope. The ontology retains scenario selection, cybersecurity structure, content-quality control, evidence grounding, semantic packets, validation decisions, and scoring metadata.</rdfs:comment>
    <dcterms:creator>PersonaShield Quest ontology project</dcterms:creator>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>9.1.0</owl:versionInfo>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-22</dcterms:modified>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-15</dcterms:created>
    <owl:priorVersion rdf:resource="http://personashield.ait.ac.th/ontology/psq-sco/9.0.0"/>
    <owl:versionIRI rdf:resource="http://personashield.ait.ac.th/ontology/psq-sco/9.1.0"/>
    <psq:frameworkName>Ontology-Driven Emotion-Aware Adaptive Cybersecurity Training Framework (ODEACT)</psq:frameworkName>
    <psq:scopeBoundary>scenario_control_only_no_learning_design_module_not_general_cybersecurity_not_engine_modification</psq:scopeBoundary>
    <dcterms:hasVersion>9.1.0</dcterms:hasVersion>
    <skos:definition xml:lang="en">Task-oriented scenario-control ontology and ontology-based KG for PSQ-SCO CQ1-CQ4, limited to scenario control, cybersecurity structure, quality rules, and evidence grounding.</skos:definition>
    <psq:reviewStatus>automated_release_validation_required; domain_expert_review_pending</psq:reviewStatus>
    <psq:sourceDocument>external-assets/PSQ_SCO_Reviewer_Aligned_Revision_v9.docx</psq:sourceDocument>
  </rdf:Description>
