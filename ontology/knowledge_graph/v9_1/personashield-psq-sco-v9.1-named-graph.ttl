<http://personashield.ait.ac.th/ontology/psq-sco> a owl:Ontology ;
    rdfs:label "PersonaShield Quest Scenario Control Ontology (PSQ-SCO) v9.1.0"@en ;
    psq:competencyQuestion "CQ1 - Scenario Selection: Which ScenarioTemplate individuals satisfy learner profile, performance state, mood-context placeholder, target transition, channel, difficulty, attack type, and retrieval-mode constraints?"@en,
        "CQ2 - Cybersecurity Structure: Which attack or legitimate-communication concepts are explicitly linked to a selected ScenarioTemplate?"@en,
        "CQ3 - Content Quality Control: Which ontology constraints and quality rules must a generated candidate scenario satisfy before acceptance into the scenario pool?"@en,
        "CQ4 - Evidence and Provenance Grounding: Which trusted sources and provenance records justify scenario structure, red flags, safe indicators, recommended response, and validation decision?"@en ;
    psq:frameworkName "Ontology-Driven Emotion-Aware Adaptive Cybersecurity Training Framework (ODEACT)" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    psq:scopeBoundary "scenario_control_only_no_learning_design_module_not_general_cybersecurity_not_engine_modification" ;
    psq:sourceDocument "external-assets/PSQ_SCO_Reviewer_Aligned_Revision_v9.docx" ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:creator "PersonaShield Quest ontology project" ;
    dcterms:hasVersion "9.1.0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-22"^^xsd:date ;
    dcterms:source <https://doi.org/10.1037/a0031311>,
        <https://doi.org/10.1080/07421222.2017.1334499>,
        <https://doi.org/10.1145/3447772>,
        <https://doi.org/10.1207/s15430421tip4104_2>,
        <https://perso.liris.cnrs.fr/alain.mille/enseignements/Ecole_Centrale/What%20is%20an%20ontology%20and%20why%20we%20need%20it.htm>,
        <https://protege.stanford.edu/publications/ontology_development/ontology101.pdf>,
        <https://www.w3.org/TR/owl2-primer/>,
        <https://www.w3.org/TR/prov-o/> ;
    dcterms:title "PersonaShield Quest Scenario Control Ontology (PSQ-SCO) v9.1.0"@en ;
    rdfs:comment "PSQ-SCO v9.1.0 is a corrected scenario-control ontology for PersonaShield Quest. It keeps the ontology limited to scenario-control resources and treats learning-design theory modules as outside the PSQ-SCO scope. The ontology retains scenario selection, cybersecurity structure, content-quality control, evidence grounding, semantic packets, validation decisions, and scoring metadata."@en ;
    owl:priorVersion <http://personashield.ait.ac.th/ontology/psq-sco/9.0.0> ;
    owl:versionIRI <http://personashield.ait.ac.th/ontology/psq-sco/9.1.0> ;
    owl:versionInfo "9.1.0" ;
    skos:definition "Task-oriented scenario-control ontology and ontology-based KG for PSQ-SCO CQ1-CQ4, limited to scenario control, cybersecurity structure, quality rules, and evidence grounding."@en .

