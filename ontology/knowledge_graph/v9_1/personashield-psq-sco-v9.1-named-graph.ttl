psq:Decision_Accept a psq:ValidationDecision,
        owl:NamedIndividual ;
    rdfs:label "Accept generated scenario"@en ;
    psq:creationMethod "reviewer_aligned_manual_modeling_v9" ;
    psq:evaluatesRule psq:Rule_ChannelConsistency,
        psq:Rule_EvidenceRequirement,
        psq:Rule_LegitimateScenarioSeparation,
        psq:Rule_PersonaFit,
        psq:Rule_QualityAcceptance,
        psq:Rule_QualityRejection,
        psq:Rule_RequiredAttackStructure,
        psq:Rule_TemplateEligibility ;
