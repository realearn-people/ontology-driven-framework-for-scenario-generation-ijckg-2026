    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "Observable suspicious cue."@en ;
    rdfs:subClassOf psq:ScenarioKnowledgeEntity ;
    skos:definition "Ontology class representing Red flag in the PersonaShield domain model."@en .

psq:ScenarioKnowledgeEntity a owl:Class ;
    rdfs:label "Scenario knowledge entity"@en ;
    psq:creationMethod "inherited_from_v8_1" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "Entity that describes scenario content, communication form, attack semantics, or safe response."@en ;
    rdfs:subClassOf psq:DomainEntity ;
    skos:definition "Entity that describes scenario content, communication form, attack semantics, or safe response."@en .

psq:EvidencePack a owl:Class ;
    rdfs:label "Evidence pack"@en ;
    psq:creationMethod "inherited_from_v8_1" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "Compact set of sources that supports scenario semantics."@en ;
    rdfs:subClassOf psq:EvidenceKnowledgeEntity ;
    skos:definition "Ontology class representing Evidence pack in the PersonaShield domain model."@en .

psq:SourceArtifact a owl:Class ;
    rdfs:label "Source artifact"@en ;
    psq:creationMethod "inherited_from_v8_1" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "Citable standard, taxonomy, paper, or guidance source."@en ;
    rdfs:subClassOf psq:EvidenceKnowledgeEntity,
        prov:Entity ;
    skos:definition "Ontology class representing Source artifact in the PersonaShield domain model."@en .

psq:LearningStage a owl:Class ;
    rdfs:label "Learning stage"@en ;
    psq:creationMethod "inherited_from_v8_1" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "One of the engine's nine exact stages."@en ;
    rdfs:subClassOf psq:LearnerKnowledgeEntity ;
    skos:definition "Exact or grouped position in the engine's nine-stage learning progression."@en .

psq:ScenarioTemplate a owl:Class ;
    rdfs:label "Scenario template"@en ;
    psq:creationMethod "inherited_from_v8_1" ;
    psq:reviewStatus "automated_release_validation_required; domain_expert_review_pending" ;
    rdfs:comment "Reusable semantic controls for one generated scenario slot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass psq:Channel ;
            owl:onProperty psq:usesChannel ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass psq:EvidencePack ;
            owl:onProperty psq:hasEvidencePack ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass psq:ScenarioVariant ;
            owl:onProperty psq:hasVariant ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass psq:SafeResponseAction ;
            owl:onProperty psq:hasSafeResponse ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass psq:ProvenanceRecord ;
            owl:onProperty psq:hasProvenanceRecord ],
        psq:ScenarioKnowledgeEntity ;
    skos:definition "A reusable scenario control object whose relationships constrain one generated game-content slot."@en .

