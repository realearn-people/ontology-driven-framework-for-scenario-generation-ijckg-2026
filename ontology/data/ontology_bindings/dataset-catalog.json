      ],
      "format": "PDF",
      "use": "Learning-objective alignment, feedback design, and safe-response guidance",
      "trust_tier": "research_and_training_reference",
      "status": "active_reference_only"
    },
    {
      "id": "thai_awareness_documents",
      "paths": [
        "data/knowledge_base/raw_data/financialfraud.pdf",
