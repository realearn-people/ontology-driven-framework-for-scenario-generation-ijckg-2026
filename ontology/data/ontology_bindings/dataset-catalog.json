{
  "version": "7.0.0",
  "created": "2026-06-14",
  "policy": {
    "raw_files_are_immutable": true,
    "duplicate_files_are_catalogued_not_deleted": true,
    "unknown_licenses_require_review_before_redistribution": true,
    "operational_harmful_content": "Do not add live malicious links or real credential collection flows to generated game scenarios."
  },
  "collections": [
    {
      "id": "mitre_attack_stix",
      "paths": [
        "data/mitre-attack/attack-stix-data/index.json",
        "data/mitre-attack/attack-stix-data/enterprise-attack/*.json",
        "data/mitre-attack/attack-stix-data/mobile-attack/*.json",
        "data/mitre-attack/attack-stix-data/ics-attack/*.json"
      ],
      "format": "STIX JSON",
      "use": "Authoritative technique identifiers and descriptions",
      "local_snapshot": "18.1 is the newest version listed in the local index",
      "source_url": "https://github.com/mitre-attack/attack-stix-data",
      "license_file": "data/mitre-attack/attack-stix-data/LICENSE.txt",
      "trust_tier": "authoritative_standard",
      "status": "active"
    },
    {
      "id": "capec",
      "paths": [
        "data/capec/capec_latest.xml"
      ],
      "format": "CAPEC XML",
      "use": "CAPEC-98 phishing and CAPEC-164 mobile phishing/smishing mappings",
      "source_url": "https://capec.mitre.org/data/downloads.html",
      "trust_tier": "authoritative_standard",
      "status": "active"
    },
    {
      "id": "processed_knowledge_base",
      "paths": [
        "data/knowledge_base/email/*.jsonl",
        "data/knowledge_base/sms/*.jsonl",
        "data/knowledge_base/voice/*.jsonl"
      ],
      "format": "JSONL",
      "record_count_observed": 12407,
      "use": "Existing RAG records for email, SMS, and voice in English and Thai",
      "schema": [
        "channel",
        "language",
        "is_scam",
        "difficulty_score",
        "messages or email fields or dialogue",
        "attack_tactics",
        "psych_triggers",
        "red_flags",
        "correct_action",
        "source"
      ],
      "quality_notes": [
        "Some legacy email records contain a smishing tactic even though their channel is email.",
        "Some records contain mojibake from legacy decoding.",
        "The v7 converter preserves the raw record, normalizes cross-channel attack labels, and emits quality flags."
      ],
      "trust_tier": "mixed_derived",
      "status": "active_after_normalization"
    },
    {
      "id": "email_raw_corpora",
      "paths": [
        "data/knowledge_base/raw_data/CEAS_08.csv",
        "data/knowledge_base/raw_data/Enron.csv",
        "data/knowledge_base/raw_data/Ling.csv",
        "data/knowledge_base/raw_data/Nazario.csv",
        "data/knowledge_base/raw_data/Nazario_5.csv",
        "data/knowledge_base/raw_data/Nigerian_5.csv",
        "data/knowledge_base/raw_data/Nigerian_Fraud.csv",
        "data/knowledge_base/raw_data/SpamAssasin.csv",
        "data/knowledge_base/raw_data/TREC_05.csv",
        "data/knowledge_base/raw_data/TREC_06.csv",
        "data/knowledge_base/raw_data/TREC_07.csv"
      ],
      "format": "CSV",
      "common_columns": [
        "sender",
        "receiver",
        "date",
        "subject",
        "body",
        "label",
        "urls"
      ],
      "exceptions": {
        "Enron.csv": [
          "subject",
          "body",
          "label"
        ],
        "Ling.csv": [
          "subject",
          "body",
          "label"
        ],
        "Nazario.csv": "Contains fields larger than the default CSV parser limit; use a raised field-size limit."
      },
      "use": "Email language, sender/domain cues, benign-vs-malicious comparison, and phishing exemplars",
      "trust_tier": "research_corpus",
      "license_status": "review individual dataset licenses before redistribution",
      "status": "active_source"
    },
    {
      "id": "sms_english",
      "paths": [
        "data/knowledge_base/raw_data/dataset_kaggle.csv",
        "data/knowledge_base/raw_data/SMSSpamCollection",
        "data/scenarios/New folder/dataset_research.csv"
      ],
      "format": "CSV or tab-separated text",
      "bindings": {
        "dataset_kaggle.csv": {
          "v1": "label",
          "v2": "message"
        },
        "SMSSpamCollection": {
          "column_1": "label",
          "column_2": "message"
        },
        "dataset_research.csv": {
          "label": "label",
          "sms": "message"
        }
      },
      "recommended_source_url": "https://archive.ics.uci.edu/dataset/228/sms+spam+collection",
      "use": "English SMS scam and legitimate-message patterns",
      "trust_tier": "research_corpus",
      "status": "active_source"
    },
    {
      "id": "sms_thai",
      "paths": [
        "unbundled-source/smsfraud.xlsx",
        "data/knowledge_base/raw_data/smsnormal.xlsx",
        "data/knowledge_base/raw_data/THFraud.txt",
        "data/knowledge_base/raw_data/THHam.txt"
      ],
      "format": "XLSX and text",
      "bindings": {
        "smsfraud.xlsx": "Sheet 'SMS หลอกลวง'; first cell is a record count and subsequent first-column cells are messages.",
        "smsnormal.xlsx": "Sheet 'SMS ทั่วไป'; first cell is a record count and subsequent first-column cells are messages."
      },
      "use": "Thai-local smishing and legitimate SMS realism",
      "trust_tier": "local_corpus",
      "license_status": "source provenance and redistribution rights require review",
      "status": "active_with_review"
    },
    {
      "id": "voice_corpora",
      "paths": [
        "data/knowledge_base/raw_data/English_Scam.txt",
        "data/knowledge_base/raw_data/English_NonScam.txt",
        "data/knowledge_base/raw_data/IRS_CompleteCall_Transcript.pdf",
        "data/scenarios/New folder/Dataset.csv"
      ],
      "format": "Text, PDF, and CSV",
      "use": "Vishing dialogue structure and legitimate-call comparison",
      "trust_tier": "mixed_research_and_local",
      "license_status": "review source provenance before redistribution",
      "status": "active_with_review"
    },
    {
      "id": "thai_fact_check_reference",
      "paths": [
        "data/knowledge_base/raw_data/dataset (1).csv",
        "data/scenarios/New folder/AFNC_Opendata_export_20260225205450.csv"
